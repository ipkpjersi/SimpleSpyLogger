# SimpleSpyLogger - Lemmy scraper config
# Copy this file to .env and fill in the values. .env is gitignored.

# Database - point at the same database the Laravel app uses.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simple_spy_logger
DB_USERNAME=root
DB_PASSWORD=

# Timezone for sent_at / captured_at. Match laravel/.env APP_TIMEZONE.
APP_TIMEZONE=America/New_York

# Lemmy instance base URL.
LEMMY_INSTANCE=https://lemmy.ml

# Comma-separated list of usernames whose comments should be scraped.
LEMMY_USERNAME=ipkpjersi

# Comments per API request (Lemmy caps this at 50).
LEMMY_PER_PAGE=50

# Email alert on fetch failure. Same shape as Laravel's MAIL_* config so
# you can copy values from laravel/.env. Leave MAIL_HOST or MAIL_TO empty
# to disable email alerts (errors still go to STDERR).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SimpleSpyLogger"
MAIL_TO=

# Discord webhook for alerts. Get one from a server channel:
#   Channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook
# Leave DISCORD_WEBHOOK_URL empty to disable. Independent of email; either,
# both, or neither channel can be enabled.
DISCORD_WEBHOOK_URL=
