# SimpleSpyLogger - Twitter/X source config.
#
# Two scripts share this file:
#   import_archive.php  one-time/idempotent backfill from "Your X data" zips
#   download.php        incremental top-up of new tweets and DMs via the X API
#
# The archive importer needs only the DB and (optionally) alert settings below.
# The API scraper additionally needs the per-account OAuth 1.0a credentials.

APP_TIMEZONE=UTC

# --- Archive importer ---------------------------------------------------------

# Import direct messages from the archives in addition to tweets. Set to false
# to backfill tweets only.
TWITTER_IMPORT_DMS=true

# --- API scraper (download.php) ----------------------------------------------

# The scraper reads tweets AND DMs using OAuth 2.0 Authorization Code with PKCE,
# read-only scopes only (tweet.read, users.read, dm.read, offline.access) - no
# write access. Per app in the X developer portal: enable User authentication
# settings as an app type with a client secret (a "confidential client"),
# register a Callback URI that matches TWITTER_A{n}_REDIRECT_URI exactly, and
# copy the Client ID and Client Secret below. Then run, once per account:
#   php oauth2_authorize.php A1
# which does the one-time browser approval and writes TWITTER_A{n}_REFRESH_TOKEN
# here. download.php exchanges that refresh token for a short-lived access token
# on every run (and persists the rotated refresh token back automatically).
#
# Accounts are TWITTER_A1_*, TWITTER_A2_*, ...; gaps are allowed and any number
# of accounts is supported. Keep these values secret.

# USERNAME is the account username (no @); USER_ID is its numeric X user id
# (find it at e.g. https://tweeterid.com or via GET /2/users/by/username/:username).
TWITTER_A1_USERNAME=first_account_username
TWITTER_A1_USER_ID=
TWITTER_A1_CLIENT_ID=
TWITTER_A1_CLIENT_SECRET=
TWITTER_A1_REDIRECT_URI=http://localhost
TWITTER_A1_REFRESH_TOKEN=

TWITTER_A2_USERNAME=second_account_username
TWITTER_A2_USER_ID=
TWITTER_A2_CLIENT_ID=
TWITTER_A2_CLIENT_SECRET=
TWITTER_A2_REDIRECT_URI=http://localhost
TWITTER_A2_REFRESH_TOKEN=

# Fetch DMs as well as tweets on each scraper run. DMs are user-scoped and cost
# extra reads; set to false to poll tweets only.
TWITTER_SCRAPE_DMS=true

# DM events read per page when checking for new DMs (1-100). The DM endpoint has
# no since_id, so each run must read the newest page to detect new DMs and is
# billed per event returned ($0.010 each). Smaller = cheaper "just checking" cost
# per UTC day (1 reads only the single newest event to confirm nothing changed),
# but more pages when a burst of new DMs arrives at once.
TWITTER_DM_MAX_RESULTS=15

# Max tweets to pull per account per run. Reads are billed per tweet, so this
# caps the spend of a single run; new tweets beyond the cap are picked up next
# run. 100 is one API page.
TWITTER_MAX_TWEETS_PER_RUN=100

# Per-resource read prices used only for the estimated-cost line the scraper
# writes to its logs. Reading your own posts via /2/users/{id}/tweets qualifies
# for X's "Owned Read" rate of $0.001 per post (the app owner reading their own
# data); DM events are not an Owned Read and cost $0.010 each. The scraper mirrors
# X's per-UTC-day dedup with a local read ledger (.read_ledger.json), so the
# logged "billed" figure reflects actual charges. Adjust if X changes pricing.
TWITTER_COST_PER_TWEET_READ=0.001
TWITTER_COST_PER_DM_READ=0.010

# --- Shared: database (same DB the Laravel app writes to) ---------------------

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Shared: failure alerts (same shape as the reddit scraper) ----------------

# Email alert. Same shape as Laravel's MAIL_* config. Leave MAIL_HOST or MAIL_TO
# empty to disable email alerts (errors still go to STDERR).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SimpleSpyLogger"
MAIL_TO=

# Discord webhook for alerts. Leave empty to disable.
DISCORD_WEBHOOK_URL=
