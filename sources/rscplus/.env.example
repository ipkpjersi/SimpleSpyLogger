# SimpleSpyLogger - RSCPlus scraper config
# Copy this file to .env and fill in the values. .env is gitignored.

# Database - point at the same database the Laravel app uses.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simple_spy_logger
DB_USERNAME=root
DB_PASSWORD=

# Timezone for sent_at / captured_at. Match laravel/.env APP_TIMEZONE.
APP_TIMEZONE=America/New_York

# Folder RSCPlus writes its *.log files to. The scraper reads the most
# recently modified *.log in this folder. Can be overridden with argv[1].
RSCPLUS_LOGS_DIR=/home/youruser/.config/RSCPlus/logs

# RSCPlus only ever connects to Preservation.
RSCPLUS_WORLD=preservation
RSCPLUS_WORLD_NAME=Preservation

# Your in-game RSC name. Used as the author of outgoing PMs, which the log
# records only as "You tell <name>: ...".
RSCPLUS_PLAYER_NAME=
